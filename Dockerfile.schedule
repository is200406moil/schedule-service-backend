FROM python:3.12-slim AS schedule-source

ARG SCHEDULE_COMMIT

ADD https://github.com/is200406moil/rtu-mirea-schedule/archive/${SCHEDULE_COMMIT}.tar.gz /tmp/schedule.tar.gz
RUN mkdir /schedule-source \
    && tar --extract --gzip --file /tmp/schedule.tar.gz \
        --strip-components=1 --directory /schedule-source

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=schedule-source /schedule-source/requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

RUN addgroup --system app \
    && adduser --system --ingroup app app

COPY --from=schedule-source /schedule-source/app ./app

EXPOSE 5000

USER app

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5000"]
