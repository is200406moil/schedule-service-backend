# Скопируйте в .env и заполните значения.
DATABASE_URL=postgresql+psycopg://user:password@localhost:15432/student_tasks
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# В production за HTTPS установите true.
COOKIE_SECURE=false
SCHEDULE_API_BASE_URL=http://localhost:5000/api/schedule
SCHEDULE_API_DOCS_URL=http://localhost:5000/docs
SCHEDULE_REFRESH_KEY=development-only
