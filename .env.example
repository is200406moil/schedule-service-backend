# Скопируйте в .env и заполните значения.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://user:password@localhost:15432/student_tasks
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
# В production обязательно установите true и запускайте сервис за HTTPS.
COOKIE_SECURE=false
SCHEDULE_API_BASE_URL=http://localhost:5000/api/schedule
SCHEDULE_API_TIMEOUT_SECONDS=5
SCHEDULE_API_DOCS_URL=http://localhost:5000/docs
SCHEDULE_REFRESH_KEY=replace-with-an-independent-random-secret
