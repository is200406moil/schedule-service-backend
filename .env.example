# Скопируйте в .env и заполните значения.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://user:password@localhost:15432/student_tasks
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
# В production обязательно установите true и запускайте сервис за HTTPS.
COOKIE_SECURE=false
SCHEDULE_API_BASE_URL=http://localhost:5000/api/schedule
# Отдельный адрес для контейнера: localhost внутри него не указывает на API расписания.
COMPOSE_SCHEDULE_API_BASE_URL=http://schedule-api:5000/api/schedule
SCHEDULE_API_TIMEOUT_SECONDS=5
SCHEDULE_API_DOCS_URL=http://localhost:5000/docs
SCHEDULE_REFRESH_KEY=replace-with-an-independent-random-secret

PRIVACY_OPERATOR_NAME=Гиёсидинов Исмоилходжа Иброхимович
PRIVACY_CONTACT_EMAIL=giyesidinov.i.i@edu.mirea.ru

# Подтверждение почты и восстановление пароля: disabled | local | smtp.
# При local или smtp подтверждение адреса обязательно для входа, в том числе старым аккаунтам.
# local сохраняет тестовые .eml в .local/mail, НЕ отправляет их пользователям.
# Используйте local только при запуске Python для разработки, не в production.
MAIL_MODE=disabled
# Адрес, который получатель письма откроет в браузере. Не внутренний адрес контейнера.
PUBLIC_BASE_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Для реальной отправки замените адрес на разрешённый вашим почтовым провайдером.
SMTP_SENDER=noreply@example.com
SMTP_TIMEOUT_SECONDS=10
